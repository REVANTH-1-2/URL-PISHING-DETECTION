{
  "manifest_version": 3,
  "name": "DeepShield AI - Phishing Detector",
  "version": "1.0",
  "description": "Real-time AI-powered phishing & scam link scanner for your browser.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
