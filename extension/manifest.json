{
  "manifest_version": 3,
  "name": "DeepShield AI - Real-time Phishing Blocker",
  "version": "1.1",
  "description": "Real-time AI-powered phishing link scanner that automatically blocks risky websites before they open.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "tabs",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
